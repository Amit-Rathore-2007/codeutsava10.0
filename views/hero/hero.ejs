                        <img src="/assets/welcome.png">
                    </div>
                    <div class="title-part2">
                        <img src="/assets/codeutsava-title-2.png">
                    </div>
                </div>
                <div class="desc">
                    <div class="desc-part1">CODE, INNOVATE AND CELEBRATE</div>
                    <div class="desc-part2">CENTRAL INDIA'S LARGEST CODING EVENT. JOIN US ON 6<sup>th</sup> - 7<sup>th</sup> November</div>
