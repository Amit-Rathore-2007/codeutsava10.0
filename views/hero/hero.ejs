        <div class="hero-sections">
            <div class="heading">TIMELINE</div>
            <div class="naruto-timeline" id="timeline">
                <div class="timeline-line"></div>
                <img style="transform: rotate(-90deg) scaleX(-1);"
                    src="/assets/naruto-running.gif"
                    class="naruto-runner"
                    alt="Naruto"
                >
                <div class="timeline">
                    <div class="timeline-item">
                        <span class="dot"></span>
                        <div class="timeline-content">
                            <h2>#1 Registration Opens!</h2>
                            <p>Registrations begin for CodeUtsava 10.0 ,the flagship event of The Turing Club of Programmers.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <span class="dot"></span>
                        <div class="timeline-content">
                            <h2>#2 Shortlisting Begins!</h2>
                            <p>Team shortlisting begins in batches.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <span class="dot"></span>
                        <div class="timeline-content">
                            <h2>#3 Registration Closes!</h2>
                            <p>Registration for CodeUtsava 10.0 officially closes.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <span class="dot"></span>
                        <div class="timeline-content">
